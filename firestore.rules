rules_version = '2';

// MedhaSetu Firestore security rules.
// Auth flow: signup writes pending_registrations/{lowercaseEmail} docs with
// {email, displayName, password, otp:{code, expiresAt}} BEFORE Firebase Auth
// user exists, then VerifyEmail reads/updates/deletes that doc pre-auth and
// creates users/{uid} after createUserWithEmailAndPassword succeeds.

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: authenticated users read/update only their own doc;
    // creation allowed during signup/verify when request.auth != null.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Pre-auth OTP flow: readable/writable without auth because no Firebase
    // Auth session exists yet. Document ID is the lowercased email, and OTP
    // payloads carry a 15-minute expiresAt enforced client-side.
    // NOTE: for production, move OTP issuance/verification into Cloud
    // Functions (e.g. callable functions with rate limiting and hashed OTPs)
    // and lock this collection down to authenticated-or-function-only access.
    match /pending_registrations/{docId} {
      allow read, create, update, delete: if true;
    }

    // Quiz content: publicly readable so guests (request.auth == null) can
    // load categories/questions and play; writes stay authenticated
    // (used by admin seed flow).
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /questions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
